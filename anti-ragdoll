local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

toggleBtn.MouseButton1Click:Connect(function()
    ativo = not ativo
    
    local btnColor = ativo and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(200, 50, 50)
    local ballPos = ativo and UDim2.new(0, 3, 0, 3) or UDim2.new(0, 25, 0, 3)
    local textColor = ativo and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
    
    statusText.Text = ativo and "✅ ATIVO" or "❌ DESATIVADO"
    
    tweenService:Create(toggleBtn, tweenInfo, {BackgroundColor3 = btnColor}):Play()
    tweenService:Create(toggleBall, tweenInfo, {Position = ballPos}):Play()
    tweenService:Create(statusText, tweenInfo, {TextColor3 = textColor}):Play()
end)

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragando = true
        dragOffset = Vector2.new(input.Position.X - frame.AbsolutePosition.X, input.Position.Y - frame.AbsolutePosition.Y)
    end
end)

userInput.InputChanged:Connect(function(input)
    if dragando and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        frame.Position = UDim2.new(0, input.Position.X - dragOffset.X, 0, input.Position.Y - dragOffset.Y)
    end
end)

userInput.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragando = false
    end
end)

local function limparForcas(char)
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BodyMover") or v:IsA("BodyVelocity") or v:IsA("BodyForce") or v:IsA("BodyPosition") or v:IsA("BodyThrust") or v:IsA("LinearVelocity") or v:IsA("VectorForce") or v:IsA("AlignPosition") then
            v:Destroy()
        end
    end
end

local function processarHit(char, humanoid, rootPart)
    if recuperando then return end
    recuperando = true

    if modoHitDeitado then
        task.wait(1.2)
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        task.wait(0.05)
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    else
        rootPart.Anchored = true
        limparForcas(char)
        
        task.wait(1.5)
        
        humanoid.Sit = false
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        
        rootPart.Anchored = false
        limparForcas(char) 
        rootPart.AssemblyLinearVelocity = Vector3.new(0, -5, 0)
        
        task.wait(0.05)
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end

    recuperando = false
end

local function monitorarForcas(char)
    char.DescendantAdded:Connect(function(descendant)
        if not ativo or recuperando then return end
        if descendant.Parent and (descendant.Parent:IsA("Tool") or descendant.Parent:IsA("Accessory")) then return end
        
        if descendant:IsA("BodyMover") or descendant:IsA("LinearVelocity") or descendant:IsA("VectorForce") or descendant:IsA("BodyVelocity") then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local rootPart = char:FindFirstChild("HumanoidRootPart")
            if humanoid and rootPart then
                processarHit(char, humanoid, rootPart)
            end
        end
    end)
end

if player.Character then monitorarForcas(player.Character) end
player.CharacterAdded:Connect(monitorarForcas)

runService.Heartbeat:Connect(function()
    if not ativo or recuperando then return end
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end
    
    if modoHitDeitado then
        if humanoid.Sit then
            humanoid.Sit = false
        end
        return
    end

    if humanoid:GetState() == Enum.HumanoidStateType.Physics or 
       humanoid:GetState() == Enum.HumanoidStateType.FallingDown or
       humanoid:GetState() == Enum.HumanoidStateType.Ragdoll or
       humanoid.Sit then
        processarHit(char, humanoid, rootPart)
        return
    end

    local currentVel = rootPart.AssemblyLinearVelocity
    local deltaX = math.abs(currentVel.X - lastVelocity.X)
    local deltaZ = math.abs(currentVel.Z - lastVelocity.Z)
    
    if deltaX > 50 or deltaZ > 50 then
        processarHit(char, humanoid, rootPart)
    end
    lastVelocity = currentVel
end)
